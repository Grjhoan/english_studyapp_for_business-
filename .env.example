# ==============================================================================
# PM ENGLISH COMPANION - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Recommended AI Model (Cheapest with high quality + Free Tier available)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Alternative AI Model (if using OpenAI instead)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Optional: Cloud Persistence for Vercel (Upstash Redis or Vercel KV)
# If left empty, local JSON storage and client-side sync will be used.
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
